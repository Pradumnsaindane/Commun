# Supabase CLI local stack environment for Commun.dev.
#
# Copy this file to `supabase/.env` (gitignored) and replace the placeholder
# passwords before running `supabase start`. These values only protect the
# disposable local database; they are never production or staging values.

# PostgreSQL superuser password for the local stack.
POSTGRES_PASSWORD=replace-with-a-strong-local-only-password

# Anon and service-role JWT secret for the local Supabase Auth server.
# These are also regenerated by `supabase start`; the printed values take
# precedence and should be copied into .env.local.example.
SUPABASE_JWT_SECRET=replace-with-a-strong-local-only-jwt-secret
