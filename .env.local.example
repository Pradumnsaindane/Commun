# Local development environment for Commun.dev.
#
# Copy this file to `.env.local` (gitignored). The Supabase URL below points at
# the disposable local Supabase CLI stack (http://127.0.0.1:54331). The ports
# come from supabase/config.jsonc and intentionally avoid the Phase 8 local
# stack. The anon and service-role keys are printed by `supabase start` and
# must be copied in after the local stack first starts. See
# docs/phase11-local-development.md.

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Supabase CLI API gateway (loopback only — never production).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331

# Preferred client-safe key. Paste the `anon public` / publishable key printed
# by `supabase start`. Never put a service-role/secret key in either NEXT_PUBLIC
# variable; the application rejects it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Deprecated fallback for deployments not yet migrated. Leave blank when the
# publishable key above is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paste the `service_role` key printed by `supabase start`. Server-side only;
# never prefix it with NEXT_PUBLIC_ or import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=
# Leave blank locally unless you run the news ingestion cron.
CRON_SECRET=

# Leave blank locally. Stripe is BLOCKED without isolated test credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEMBERSHIP_MONTHLY=

# Leave blank locally. Upstash KV rate limiting is BLOCKED without isolated credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
