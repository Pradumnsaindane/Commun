# Public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only configuration; never expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Vercel KV/Upstash REST integration
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=server-only-kv-token
# Canonical Upstash names are also supported:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Stripe creator monetization (server-only; checkout degrades gracefully when absent)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Recurring membership price on the PLATFORM Stripe account (price_...)
STRIPE_PRICE_MEMBERSHIP_MONTHLY=price_your-monthly-membership
# Platform cut charged on every membership invoice (0-100, default 10)
STRIPE_PLATFORM_FEE_PERCENT=10
