# Commun.dev environment template.
#
# Leave every secret blank. Fill these values only in a private .env.local, in
# CI secrets, or in the hosting provider's secret store. Never commit them.
# A blank value is treated as unconfigured; do not paste fake or sample values
# that look like working credentials.

# Public client configuration
# Expected format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Expected format: a publishable/anon key from the isolated Supabase project
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only configuration; never expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Vercel KV / Upstash REST integration (isolated staging namespace only)
# Expected format: https://<isolated-database>.upstash.io
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Canonical Upstash names are also supported:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional scheduled news ingestion secret (server-only)
CRON_SECRET=

# Stripe creator monetization (server-only; checkout degrades gracefully when absent).
# Use test mode only for staging. Never use a live key here.
# Expected formats: sk_test_..., whsec_..., price_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEMBERSHIP_MONTHLY=
# Platform cut charged on every membership invoice (0-100, default 10)
STRIPE_PLATFORM_FEE_PERCENT=10

# Real integration verification uses separate PHASE_D_* / PHASE5_* names so it
# can never silently reuse the application project. See:
#   docs/staging-infrastructure.md
#   docs/phase-5-infrastructure-readiness.md
#   docs/phase-5-integration-report.md
# These variables are intentionally not populated in this template.
